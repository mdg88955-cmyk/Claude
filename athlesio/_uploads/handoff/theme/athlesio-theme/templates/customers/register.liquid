<section class="section"><div class="container" style="max-width:420px">
  <h1>Create account</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <label for="rf">First name</label>
    <input class="qty" style="width:100%" type="text" name="customer[first_name]" id="rf" autocomplete="given-name">
    <label for="rl" style="margin-top:var(--sp-3);display:block">Last name</label>
    <input class="qty" style="width:100%" type="text" name="customer[last_name]" id="rl" autocomplete="family-name">
    <label for="re" style="margin-top:var(--sp-3);display:block">Email</label>
    <input class="qty" style="width:100%" type="email" name="customer[email]" id="re" autocomplete="email">
    <label for="rp" style="margin-top:var(--sp-3);display:block">Password</label>
    <input class="qty" style="width:100%" type="password" name="customer[password]" id="rp" autocomplete="new-password">
    <button class="btn btn--primary btn--full" type="submit" style="margin-top:var(--sp-4)">Create account</button>
  {%- endform -%}
</div></section>
