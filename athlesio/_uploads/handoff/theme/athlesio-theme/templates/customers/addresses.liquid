<section class="section"><div class="container">
  <h1>Addresses</h1>
  {%- for address in customer.addresses -%}
    <div class="honesty" style="margin-bottom:var(--sp-4)">{{ address | format_address }}</div>
  {%- else -%}
    <p class="muted">No saved addresses.</p>
  {%- endfor -%}
  <p><a href="{{ routes.account_url }}">Back to account</a></p>
</div></section>
