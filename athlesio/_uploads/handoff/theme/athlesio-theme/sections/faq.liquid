<section class="section--tight">
  <div class="container">
    <h2 data-reveal>{{ section.settings.heading }}</h2>
    <div class="faq" style="margin-top:var(--sp-5)">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <p>{{ block.settings.a }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "textarea", "id": "a", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "q": "How long until I notice anything?", "a": "Creatine works by saturating muscle stores, which takes roughly three to four weeks of daily use. There is no meaningful day-one effect." } },
        { "type": "qa", "settings": { "q": "Do I need a loading phase?", "a": "No. Loading protocols saturate stores faster; a standard daily amount gets you to the same place over a few more weeks." } },
        { "type": "qa", "settings": { "q": "Will it make me gain weight?", "a": "Creatine draws water into muscle cells, so some people see a small increase on the scale in the first weeks. It is intracellular water, not fat." } },
        { "type": "qa", "settings": { "q": "Can I take it on rest days?", "a": "Yes. Daily consistency is the point, rest days included." } },
        { "type": "qa", "settings": { "q": "Is it vegan?", "a": "Yes. No gelatin, and the creatine is synthesised rather than animal-derived." } }
      ]
    }
  ]
}
{% endschema %}
