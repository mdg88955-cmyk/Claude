{%- comment -%}
  Hero v2 — product-first. Works with zero configuration: if no background
  image is set, an animated gradient aura fills the space instead of a void.
{%- endcomment -%}

{%- liquid
  assign p = section.settings.product
  if p == blank
    for prod in collections.all.products
      if prod.available
        assign p = prod
        break
      endif
    endfor
  endif
-%}

<section class="heroX">
  <div class="heroX__aura" aria-hidden="true"></div>

  {%- if section.settings.image -%}
    <div class="hero__media" style="opacity:.35">
      <img src="{{ section.settings.image | image_url: width: 2200 }}" alt="" width="2200" height="1238" loading="eager" fetchpriority="high">
    </div>
    <div class="hero__scrim"></div>
  {%- endif -%}

  <div class="container">
    <div class="heroX__grid">

      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h1>
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank %}
            <br><span class="grad">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h1>

        {%- if section.settings.sub != blank -%}
          <p class="heroX__sub">{{ section.settings.sub }}</p>
        {%- endif -%}

        <div class="heroX__buy">
          {%- if p != blank -%}
            <div class="heroX__price">
              {{ p.price | money }}
              <small>{{ section.settings.unit_note }}</small>
            </div>
            <a class="btn btn--primary" href="{{ p.url }}">{{ section.settings.cta_text }}</a>
          {%- else -%}
            <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_url != blank -%}
            <a class="btn btn--secondary" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_text }}</a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="pills">
            {%- for block in section.blocks -%}
              <span class="pill" {{ block.shopify_attributes }}>
                {%- if block.settings.value != blank -%}<b>{{ block.settings.value }}</b> {% endif -%}
                {{ block.settings.label }}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="heroX__stage">
        <div class="heroX__glow" aria-hidden="true"></div>
        {%- if section.settings.product_image -%}
          <img class="heroX__jar" src="{{ section.settings.product_image | image_url: width: 1100 }}"
               alt="{{ p.title | default: shop.name | escape }}" width="520" height="520" loading="eager" fetchpriority="high">
        {%- elsif p.featured_media -%}
          <img class="heroX__jar" src="{{ p.featured_media | image_url: width: 1100 }}"
               alt="{{ p.featured_media.alt | default: p.title | escape }}" width="520" height="520" loading="eager" fetchpriority="high">
        {%- else -%}
          <div class="heroX__empty">
            <span class="eyebrow" style="margin:0">Product image</span>
            <p class="muted" style="font-size:14px;margin:0">Pick a product in this section, or upload a jar shot, and it appears here at full size.</p>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Drives the price and the jar shot. Falls back to the first available product." },
    { "type": "image_picker", "id": "product_image", "label": "Jar shot override", "info": "Optional. Transparent PNG works best." },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Optional. The gradient aura already fills the space, so leave it empty if you have no strong shot." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "5,000 mg creatine - three gummies - no shaker" },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Creatine you'll" },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (gradient)", "default": "actually take." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Most people quit creatine because of the shaker, not the results. Three berry gummies a day. Forty servings a jar. That's the whole routine." },
    { "type": "text", "id": "unit_note", "label": "Note under price", "default": "120 gummies - 40 servings" },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Add to cart" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "See what's in it" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Spec pill",
      "settings": [
        { "type": "text", "id": "value", "label": "Number" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "pill", "settings": { "value": "5,000 mg", "label": "creatine monohydrate" } },
        { "type": "pill", "settings": { "value": "8,005 mg", "label": "active complex" } },
        { "type": "pill", "settings": { "value": "0 g", "label": "added sugar" } },
        { "type": "pill", "settings": { "value": "40", "label": "servings per jar" } }
      ]
    }
  ]
}
{% endschema %}
