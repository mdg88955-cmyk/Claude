<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="marquee__item">{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "blocks": [
    { "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Sugar-free" } },
        { "type": "item", "settings": { "text": "Vegan - no gelatin" } },
        { "type": "item", "settings": { "text": "Non-GMO" } },
        { "type": "item", "settings": { "text": "40 servings per jar" } },
        { "type": "item", "settings": { "text": "Ships from Austria" } },
        { "type": "item", "settings": { "text": "14-day returns" } }
      ]
    }
  ]
}
{% endschema %}
