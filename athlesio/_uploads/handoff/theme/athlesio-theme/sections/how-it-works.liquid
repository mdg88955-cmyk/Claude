{%- comment -%}
  The signature element: the tiger appears exactly once per page, here.
  Do not add it to product cards, the footer, or loading states.
{%- endcomment -%}
<section class="section tiger-band" data-tiger>
  {%- if settings.tiger_mark -%}
    <img class="tiger-band__mark" src="{{ settings.tiger_mark | image_url: width: 1600 }}" alt="" width="1600" height="1600" loading="lazy">
  {%- endif -%}

  <div class="container tiger-band__content">
    {%- if section.settings.heading != blank -%}
      <h2 data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.sub != blank -%}
      <p class="lead" data-reveal style="margin-bottom:var(--sp-6)">{{ section.settings.sub }}</p>
    {%- endif -%}

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" data-reveal {{ block.shopify_attributes }}>
          <span class="step__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to take it" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Creatine saturates your muscles over weeks, not minutes. Timing barely matters. Consistency does." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Three gummies", "text": "One serving. Chew them, no water needed, no chalky aftertaste." } },
        { "type": "step", "settings": { "title": "Any time of day", "text": "Pre-workout, post-workout, with breakfast. Whenever you will actually remember." } },
        { "type": "step", "settings": { "title": "Every day, including rest days", "text": "Give it three to four weeks. There is no meaningful day-one effect, and any brand telling you otherwise is selling you something." } }
      ]
    }
  ]
}
{% endschema %}
