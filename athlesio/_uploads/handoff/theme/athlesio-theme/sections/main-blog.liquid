<section class="section">
  <div class="container">
    <h1>{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="grid" style="margin-top:var(--sp-6)">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            {%- if article.image -%}
              <div class="card__media"><img src="{{ article.image | image_url: width: 600 }}" alt="" width="300" height="300" loading="lazy"></div>
            {%- endif -%}
            <div class="card__body">
              <h3 class="card__title">{{ article.title }}</h3>
              <span class="muted mono" style="font-size:12px">{{ article.published_at | date: '%d.%m.%Y' }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
