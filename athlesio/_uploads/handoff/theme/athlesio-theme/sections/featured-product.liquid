{%- assign p = section.settings.product -%}
<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if p != blank -%}
      <div class="product" style="margin-top:var(--sp-6)">
        <div class="product__main-img" data-reveal>
          {%- if p.featured_media -%}
            <img src="{{ p.featured_media | image_url: width: 1000 }}" alt="{{ p.featured_media.alt | escape }}" width="1000" height="1000" loading="lazy">
          {%- endif -%}
        </div>
        <div data-reveal>
          <h3>{{ p.title }}</h3>
          <div class="product__price mono">{{ p.price | money }}</div>
          <p class="muted">{{ p.description | strip_html | truncatewords: 45 }}</p>
          <a class="btn btn--primary" href="{{ p.url }}">View product</a>
        </div>
      </div>
    {%- else -%}
      <div class="grid" style="margin-top:var(--sp-6)">
        {%- for product in collections.all.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The product" },
    { "type": "product", "id": "product", "label": "Product" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
