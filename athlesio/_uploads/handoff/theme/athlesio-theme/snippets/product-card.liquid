<a class="card" href="{{ product.url }}" data-reveal>
  <div class="card__media">
    {%- if product.featured_media -%}
      <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | escape }}" width="300" height="300" loading="lazy">
    {%- endif -%}
  </div>
  <div class="card__body">
    <h3 class="card__title">{{ product.title }}</h3>
    <span class="card__price">{{ product.price | money }}</span>
  </div>
</a>
