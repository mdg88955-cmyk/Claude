    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "How long until I notice anything?",
            "a": "Roughly three to four weeks of daily use. There is no meaningful day-one effect."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Do I need a loading phase?",
            "a": "No. A standard daily amount gets you to the same place over a few more weeks."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Will it make me gain weight?",
            "a": "Creatine draws water into muscle cells. It is intracellular water, not fat."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Can I take it on rest days?",
            "a": "Yes. Daily consistency is the point."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Is it vegan?",
            "a": "Yes. No gelatin, and the creatine is synthesised rather than animal-derived."
          }
        }
      },
