<section class="section"><div class="container" style="max-width:420px">
  <h1>Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="np">New password</label>
    <input class="qty" style="width:100%" type="password" name="customer[password]" id="np" autocomplete="new-password">
    <label for="nc" style="margin-top:var(--sp-3);display:block">Confirm</label>
    <input class="qty" style="width:100%" type="password" name="customer[password_confirmation]" id="nc" autocomplete="new-password">
    <button class="btn btn--primary btn--full" type="submit" style="margin-top:var(--sp-4)">Reset</button>
  {%- endform -%}
</div></section>
