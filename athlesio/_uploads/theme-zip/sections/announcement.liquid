{%- if section.settings.text != blank -%}
<div style="background:var(--ath-surface-2);border-bottom:1px solid var(--ath-line)">
  <div class="container" style="padding-block:10px;text-align:center">
    <span class="mono" style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ath-fg-muted)">
      {{ section.settings.text }}
    </span>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over EUR 50 - dispatched from Austria" }
  ]
}
{% endschema %}
