<section class="section" style="min-height:80vh;display:grid;place-items:center;text-align:center">
  <div class="container" style="max-width:480px">
    <h1><span class="grad">{{ shop.name }}</span></h1>
    <p class="lead">Opening soon.</p>
    {%- form 'storefront_password' -%}
      <div style="display:flex;gap:var(--sp-2);margin-top:var(--sp-5)">
        <label class="visually-hidden" for="pw">Password</label>
        <input id="pw" class="qty" type="password" name="password" style="flex:1;width:auto" placeholder="Password">
        <button class="btn btn--primary" type="submit">Enter</button>
      </div>
      {%- if form.errors -%}<p style="color:var(--ath-danger);margin-top:var(--sp-3)">Wrong password.</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}{ "name": "Password" }{% endschema %}
