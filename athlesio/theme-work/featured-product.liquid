{%- comment -%}
  Featured product.

  This section used to fall back to a four-up grid of collections.all.products when no
  product was picked. On the 29 Jul homepage that fallback pulled the archived duplicate
  with its typo-ridden supplier infographic — the failure recorded in SESSION-LOG part 3.

  It now falls back to the first available product and renders it the same way as a
  configured one, so the section looks deliberate with zero configuration. The grid is
  gone; if there is genuinely no product, it says so instead of rendering an empty row.
{%- endcomment -%}

{%- assign p = section.settings.product -%}
{%- if p == blank -%}
  {%- assign p = collections.all.products.first -%}
{%- endif -%}

<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}

    {%- if p != blank -%}
      <div class="product" style="margin-top:var(--sp-6)">
        <div class="product__main-img" data-reveal>
          {%- if p.featured_media -%}
            <img src="{{ p.featured_media | image_url: width: 1000 }}"
                 alt="{{ p.featured_media.alt | escape }}"
                 width="1000" height="1000" loading="lazy">
          {%- endif -%}
        </div>
        <div data-reveal>
          <h3>{{ p.title }}</h3>
          <div class="product__price mono">
            {%- if p.price_varies -%}From {% endif -%}
            {{ p.price | money }}
          </div>
          <p class="muted">{{ p.description | strip_html | truncatewords: 45 }}</p>
          <a class="btn btn--primary" href="{{ p.url }}">View product</a>
        </div>
      </div>
    {%- else -%}
      <p class="muted mono" style="margin-top:var(--sp-6)">No product is available yet.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The product" },
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to show the first available product automatically." }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
