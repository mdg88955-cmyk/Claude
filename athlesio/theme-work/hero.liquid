{%- comment -%}
  Hero.

  The primary CTA used to render only when cta_url was set in the theme editor. The
  homepage template ships with "settings": {} and the schema gives cta_url no default,
  so the live homepage had no call to action at all — no way to reach the product.

  The primary button now always renders. It uses the configured link when there is one,
  otherwise the first available product, otherwise the all-products collection. The
  governing rule for this theme is that it must look finished with zero configuration.
{%- endcomment -%}

{%- assign fallback_product = collections.all.products.first -%}
{%- assign cta1_url = section.settings.cta_url -%}
{%- if cta1_url == blank -%}
  {%- if fallback_product -%}
    {%- assign cta1_url = fallback_product.url -%}
  {%- else -%}
    {%- assign cta1_url = routes.all_products_collection_url -%}
  {%- endif -%}
{%- endif -%}

<section class="hero">
  {%- if section.settings.image -%}
    <div class="hero__media">
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           alt="" width="2000" height="1125" loading="eager" fetchpriority="high">
    </div>
    <div class="hero__scrim"></div>
  {%- endif -%}

  <div class="container">
    <div class="hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1>
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank %}
          <br><span class="grad">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.sub != blank -%}
        <p class="hero__sub">{{ section.settings.sub }}</p>
      {%- endif -%}

      <div class="hero__cta">
        <a class="btn btn--primary" href="{{ cta1_url }}">
          {{ section.settings.cta_text | default: 'Shop the gummies' }}
        </a>
        {%- if section.settings.cta2_url != blank -%}
          <a class="btn btn--secondary" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Dark, atmospheric, with empty space on the right. Never bake text into it." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Creatine, without the shaker" },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "The boring part," },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (gradient)", "default": "done properly." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Creatine monohydrate, BCAAs, L-carnitine and taurine in a sugar-free berry gummy. Three a day. Forty servings a jar." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop the gummies" },
    { "type": "url", "id": "cta_url", "label": "Primary link", "info": "Leave empty to link to the first available product automatically." },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "What's actually in it" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link", "info": "Optional. The button is hidden when this is empty." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
