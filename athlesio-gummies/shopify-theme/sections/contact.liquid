{%- comment -%} Kontaktseite mit nativem Shopify-Kontaktformular. {%- endcomment -%}
<div class="page legal contact">
  <div class="wrap">
    <h1>{{ section.settings.heading | default: 'Kontakt' }}</h1>
    <p>{{ section.settings.intro | default: 'Fragen zu deiner Bestellung, zum Versand oder zum Produkt? Schreib uns – wir antworten in der Regel innerhalb von 24 Stunden (Mo–Fr).' }}</p>

    <p class="contact__meta">
      E-Mail: <a href="mailto:{{ section.settings.email | default: 'info@athlesio.at' }}">{{ section.settings.email | default: 'info@athlesio.at' }}</a><br>
      {% if section.settings.phone != blank %}Telefon: {{ section.settings.phone }}<br>{% endif %}
      Web: athlesio.at
    </p>

    {% if section.settings.show_form %}
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="contact__success">Danke für deine Nachricht! Wir melden uns so schnell wie möglich.</p>
        {% endif %}
        {% if form.errors %}
          <p class="contact__error">Bitte prüfe deine Eingaben: {{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="contact__row">
          <label for="cf-name">Name</label>
          <input type="text" id="cf-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" required>
        </div>
        <div class="contact__row">
          <label for="cf-email">E-Mail</label>
          <input type="email" id="cf-email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" required>
        </div>
        <div class="contact__row">
          <label for="cf-body">Nachricht</label>
          <textarea id="cf-body" name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
        <button type="submit" class="button">Nachricht senden</button>
      {% endform %}
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Kontakt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontakt" },
    { "type": "textarea", "id": "intro", "label": "Einleitung", "default": "Fragen zu deiner Bestellung, zum Versand oder zum Produkt? Schreib uns – wir antworten in der Regel innerhalb von 24 Stunden (Mo–Fr)." },
    { "type": "text", "id": "email", "label": "E-Mail", "default": "info@athlesio.at" },
    { "type": "text", "id": "phone", "label": "Telefon (optional)", "default": "" },
    { "type": "checkbox", "id": "show_form", "label": "Kontaktformular anzeigen", "default": true }
  ]
}
{% endschema %}
